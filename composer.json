{
    "name": "shel/neos-mcp",
    "description": "MCP server components for interaction with the Neos Content Repository, built on Sitegeist.Pandora. Gives an AI agent a seat in the Neos team: a user of its own, a role with defined privileges, a personal workspace and the review workflow of the editors, enforced by the policies of Neos.",
    "license": "GPL-3.0-or-later",
    "type": "neos-package",
    "config": {
        "vendor-dir": "Packages/Libraries",
        "bin-dir": "bin",
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "neos/composer-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sitegeist/Sitegeist.Pandora.git"
        }
    ],
    "require": {
        "neos/flow": "^8.3.0",
        "mcp/sdk": "^0.7.0",
        "sitegeist/pandora": "*"
    },
    "conflict": {
        "sitegeist/slopmachine": "*"
    },
    "require-dev": {
        "neos/buildessentials": "^8.3",
        "neos/neos": "^8.3",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^11.0",
        "symfony/css-selector": "~2.0",
        "neos/behat": "^8.3",
        "editorconfig-checker/editorconfig-checker": "^10.0",
        "squizlabs/php_codesniffer": "^3.4",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Shel\\Neos\\Mcp\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shel\\Neos\\Mcp\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Shel.Neos.Mcp"
        }
    },
    "scripts": {
        "post-update-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
        "post-install-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
        "post-package-update": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",
        "post-package-install": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",

        "lint:phpcs": "phpcs --colors --standard=PSR12 Classes Tests",
        "lint:phpstan": "phpstan analyse",
        "lint": [
            "@lint:phpcs",
            "@lint:phpstan"
        ],

        "test": "echo \"No tests yet.\""
    }
}
